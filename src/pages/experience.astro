---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { experiences } from '@/data/experiences';
---

<BaseLayout title="Expériences" description="Mon parcours professionnel">
  <section class="section-container">
    <h1 class="text-4xl font-bold mb-2" style="color: var(--color-text);">Expériences</h1>
    <p class="mb-12" style="color: var(--color-text-muted);">Mon parcours professionnel.</p>

    <div class="relative">
      <div class="absolute left-3 top-0 bottom-0 w-px hidden sm:block" style="background-color: var(--color-border);"></div>

      <div class="flex flex-col gap-10">
        {experiences.map((exp) => (
          <div class="sm:pl-10 relative">
            <div
              class="absolute left-0 top-1.5 w-7 h-7 rounded-full border-2 border-accent-500 hidden sm:flex items-center justify-center"
              style="background-color: var(--color-bg);"
            >
              <div class="w-2 h-2 rounded-full bg-accent-400"></div>
            </div>
            <div
              class="border rounded-xl p-6 hover:border-accent-500/30 transition-colors"
              style="background-color: var(--color-surface); border-color: var(--color-border);"
            >
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div>
                  <h2 class="text-lg font-semibold" style="color: var(--color-text);">{exp.title}</h2>
                  <p class="text-accent-500 font-mono text-sm">{exp.company}</p>
                </div>
                <span
                  class="text-xs font-mono px-3 py-1 rounded-full shrink-0"
                  style="color: var(--color-text-muted); background-color: var(--color-border);"
                >
                  {exp.period}
                </span>
              </div>
              <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text-muted);">{exp.description}</p>
              <div class="flex flex-wrap gap-2">
                {exp.tags.map((tag) => (
                  <span class="text-xs font-mono bg-accent-600/20 text-accent-600 dark:text-accent-300 px-2 py-0.5 rounded">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
