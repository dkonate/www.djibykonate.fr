---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil" description="Djiby Konate — Développeur Backend">
  <section class="section-container flex flex-col md:flex-row items-center gap-12 min-h-[calc(100vh-4rem)]">

    <!-- Texte -->
    <div class="flex-1 flex flex-col justify-center">
      <p class="font-mono text-accent-500 text-sm mb-4 tracking-widest uppercase">Bonjour, je suis</p>
      <h1 class="text-5xl sm:text-7xl font-bold mb-4 leading-tight" style="color: var(--color-text);">
        Djiby<br /><span class="text-accent-500">Konate</span>
      </h1>
      <p class="text-xl sm:text-2xl mb-6" style="color: var(--color-text-muted);">
        Développeur Backend — je construis des systèmes robustes, rapides et maintenables.
      </p>
      <p class="mb-10 leading-relaxed" style="color: var(--color-text-muted);">
        Passionné par les architectures distribuées, les APIs performantes et les outils CLI.
        J'écris aussi sur mon blog pour partager ce que j'apprends.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/projects"
          class="px-6 py-3 bg-accent-600 hover:bg-accent-500 text-white font-medium rounded-lg transition-colors"
        >
          Voir mes projets
        </a>
        <a
          href="/blog"
          class="px-6 py-3 border font-medium rounded-lg transition-colors hover:text-accent-500 hover:border-accent-500"
          style="border-color: var(--color-border); color: var(--color-text-muted);"
        >
          Lire le blog
        </a>
      </div>
      <div class="flex gap-4 mt-12">
        <a
          href="https://github.com/djibykonate"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-500 transition-colors text-sm font-mono"
          style="color: var(--color-text-muted);"
        >
          GitHub ↗
        </a>
        <a
          href="https://linkedin.com/in/djibykonate"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent-500 transition-colors text-sm font-mono"
          style="color: var(--color-text-muted);"
        >
          LinkedIn ↗
        </a>
        <a
          href="/contact"
          class="hover:text-accent-500 transition-colors text-sm font-mono"
          style="color: var(--color-text-muted);"
        >
          Contact ↗
        </a>
      </div>
    </div>

    <!-- Photo -->
    <div class="shrink-0 flex items-center justify-center order-first md:order-last">
      <div
        class="w-56 h-56 sm:w-72 sm:h-72 rounded-full border-2 border-dashed overflow-hidden flex items-center justify-center"
        style="border-color: var(--color-border); background-color: var(--color-surface);"
      >
        <!--
          Remplace ce bloc par une balise <img> quand tu as ta photo :
          <img src="/photo.jpg" alt="Djiby Konate" class="w-full h-full object-cover" />
        -->
        <div class="text-center px-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1" style="color: var(--color-text-muted);">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          <p class="text-xs font-mono opacity-40" style="color: var(--color-text-muted);">photo.jpg</p>
        </div>
      </div>
    </div>

  </section>
</BaseLayout>
