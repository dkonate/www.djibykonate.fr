---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Accueil" description="Djiby Konate — Développeur Backend">
  <section class="section-container flex flex-col justify-center min-h-[calc(100vh-4rem)]">
    <p class="font-mono text-accent-500 text-sm mb-4 tracking-widest uppercase">Bonjour, je suis</p>
    <h1 class="text-5xl sm:text-7xl font-bold mb-4 leading-tight" style="color: var(--color-text);">
      Djiby<br /><span class="text-accent-500">Konate</span>
    </h1>
    <p class="text-xl sm:text-2xl mb-6 max-w-xl" style="color: var(--color-text-muted);">
      Développeur Backend — je construis des systèmes robustes, rapides et maintenables.
    </p>
    <p class="max-w-2xl mb-10 leading-relaxed" style="color: var(--color-text-muted);">
      Passionné par les architectures distribuées, les APIs performantes et les outils CLI.
      J'écris aussi sur mon blog pour partager ce que j'apprends.
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href="/projects"
        class="px-6 py-3 bg-accent-600 hover:bg-accent-500 text-white font-medium rounded-lg transition-colors"
      >
        Voir mes projets
      </a>
      <a
        href="/blog"
        class="px-6 py-3 border font-medium rounded-lg transition-colors hover:text-accent-500 hover:border-accent-500"
        style="border-color: var(--color-border); color: var(--color-text-muted);"
      >
        Lire le blog
      </a>
    </div>
    <div class="flex gap-4 mt-12">
      <a
        href="https://github.com/djibykonate"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent-500 transition-colors text-sm font-mono"
        style="color: var(--color-text-muted);"
      >
        GitHub ↗
      </a>
      <a
        href="https://linkedin.com/in/djibykonate"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent-500 transition-colors text-sm font-mono"
        style="color: var(--color-text-muted);"
      >
        LinkedIn ↗
      </a>
      <a
        href="/contact"
        class="hover:text-accent-500 transition-colors text-sm font-mono"
        style="color: var(--color-text-muted);"
      >
        Contact ↗
      </a>
    </div>
  </section>
</BaseLayout>
