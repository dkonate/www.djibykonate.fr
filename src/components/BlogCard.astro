---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
}

const { title, description, date, tags, slug } = Astro.props;

const formattedDate = date.toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="border-b py-6 group" style="border-color: var(--color-border);">
  <div class="flex flex-col gap-2">
    <div class="flex items-center gap-3 text-xs font-mono" style="color: var(--color-text-muted);">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      <span>·</span>
      <div class="flex gap-2 flex-wrap">
        {tags.map((tag) => (
          <span class="bg-accent-600/20 text-accent-600 dark:text-accent-300 px-2 py-0.5 rounded">{tag}</span>
        ))}
      </div>
    </div>
    <a href={`/blog/${slug}`}>
      <h2
        class="text-xl font-semibold group-hover:text-accent-500 transition-colors"
        style="color: var(--color-text);"
      >
        {title}
      </h2>
    </a>
    <p class="text-sm leading-relaxed" style="color: var(--color-text-muted);">{description}</p>
    <a
      href={`/blog/${slug}`}
      class="text-accent-500 hover:text-accent-400 text-sm font-mono transition-colors self-start mt-1"
    >
      Lire la suite →
    </a>
  </div>
</article>
