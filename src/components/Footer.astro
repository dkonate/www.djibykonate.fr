---
const year = new Date().getFullYear();
const socials = [
  { href: 'https://github.com/djibykonate', label: 'GitHub' },
  { href: 'https://linkedin.com/in/djibykonate', label: 'LinkedIn' },
];
---

<footer class="py-8 mt-16 border-t" style="border-color: var(--color-border);">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm" style="color: var(--color-text-muted);">© {year} Djiby Konate</p>
    <div class="flex gap-4">
      {socials.map(({ href, label }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm transition-colors hover:text-accent-500"
          style="color: var(--color-text-muted);"
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</footer>
